# ============================================================================
# Meridian — environment variables
#
# Copy this file to `.env.local` for local development, and set the same
# names as Environment Variables in the Vercel project dashboard for
# production. Nothing in this file is a real secret — every value below is a
# placeholder. The app is written to boot and build cleanly with all of these
# unset; each integration simply stays inert (auth disabled, payments
# disabled, live data falls back to the mock feed, etc.) until configured.
# ============================================================================

# ---- Supabase (auth + database) -------------------------------------------
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Never expose this to the browser. Used by webhook/admin routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Stripe (payments) ------------------------------------------------------
# Test-mode keys (sk_test_/pk_test_) until you're ready to go live.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# From the Stripe CLI (`stripe listen`) locally, or the webhook endpoint's
# signing secret in the Stripe dashboard for production.
STRIPE_WEBHOOK_SECRET=whsec_...
# The €250 funded-tier deposit, in cents. Stripe amounts are always integers.
NEXT_PUBLIC_MIN_DEPOSIT_CENTS=25000
# Safety gate — see src/lib/stripe/config.js. Must be the literal string
# "true" to allow anything beyond a Stripe *test-mode* checkout session to
# actually credit a ledger balance. Leave unset/false until a licensed
# broker-partner integration exists — see MERIDIAN_PHASE2_REPORT.md,
# Section 3.4, and the comment block at the top of
# src/app/api/stripe/webhook/route.js before ever setting this to true.
PAYMENTS_LIVE_MODE=false

# ---- Polygon.io (live market data) -----------------------------------------
POLYGON_API_KEY=your-polygon-api-key

# ---- Daily.co (video consulting rooms) -------------------------------------
DAILY_API_KEY=your-daily-api-key
# Your Daily domain, e.g. https://your-team.daily.co
NEXT_PUBLIC_DAILY_DOMAIN=https://your-team.daily.co

# ---- App -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
